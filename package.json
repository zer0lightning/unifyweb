{
  "name": "unifyweb",
  "version": "1.2.3",
  "description": "Pair, tune and automate Logitech receivers and devices from the browser (WebHID).",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.js",
    "watch": "node scripts/build.js --watch",
    "lint": "eslint src tests scripts",
    "test": "npm run test:unit && npm run build && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.js\""
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0"
  }
}
